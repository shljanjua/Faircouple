# ---------------------------------------------------------------------------
# FairCouples — environment variables
# Copy to .env.local for development, and set the same values on your host
# (Hostinger VPS / any Node host / GitHub Actions secrets) for production.
# ---------------------------------------------------------------------------

# Public site URL — used for canonicals, sitemap, OG tags, emails and redirects.
NEXT_PUBLIC_SITE_URL=https://grey-opossum-178268.hostingersite.com

# --- Hostinger MySQL -------------------------------------------------------
# hPanel → Databases → MySQL Databases shows the host, database and user.
# If the Node server runs outside Hostinger, switch on "Remote MySQL" for its
# IP address, and use the hostname hPanel gives you there instead of localhost.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=u237845628_Faircouple
MYSQL_USER=u237845628_Faircouple
MYSQL_PASSWORD=your-mysql-password
# Hostinger shared MySQL allows a modest number of connections — keep this low.
MYSQL_POOL_SIZE=8
# Set to true only if your MySQL host requires TLS.
MYSQL_SSL=false

# --- Sessions --------------------------------------------------------------
# Signs the session cookie. At least 32 characters.
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# --- File storage ----------------------------------------------------------
# Photos, booking documents and avatars are written here, outside the web root,
# and served only through /api/files after the session and couple membership
# have been checked. Use an absolute path that survives deploys.
UPLOAD_DIR=/home/u237845628/faircouples-uploads

# --- Stripe ----------------------------------------------------------------
# These can also be managed from Admin → Payments (database values win).
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- PayPal ----------------------------------------------------------------
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_WEBHOOK_ID=your-webhook-id
# live | sandbox
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# --- SMTP ------------------------------------------------------------------
# Optional: Admin → Emails stores these in the database as well, and the
# database values win. Hostinger email uses smtp.hostinger.com on port 465.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@your-domain.com
SMTP_PASSWORD=your-mailbox-password

# --- Cron / scheduled jobs -------------------------------------------------
# Protects /api/cron. Generate with: openssl rand -hex 32
CRON_SECRET=change-me
