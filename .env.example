# ---------------------------------------------------------------------------
# FairCouples — environment variables
# Copy to .env.local for development, and set the same values in your host
# (Vercel / Hostinger VPS / GitHub Actions secrets) for production.
# ---------------------------------------------------------------------------

# Public site URL — used for canonicals, sitemap, OG tags and redirects.
NEXT_PUBLIC_SITE_URL=https://faircouples.com

# --- Supabase --------------------------------------------------------------
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Never expose this one to the browser. Used by webhooks and admin actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ----------------------------------------------------------------
# These can also be managed from Admin → Payments (database values win).
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- PayPal ----------------------------------------------------------------
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_WEBHOOK_ID=your-webhook-id
# live | sandbox
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# --- Cron / scheduled jobs -------------------------------------------------
# Protects /api/cron/* endpoints. Generate with: openssl rand -hex 32
CRON_SECRET=change-me
